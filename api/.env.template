# ── Service identity ─────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=<your-service-name>               # e.g. axum-api-push

# ── Grafana Cloud OTLP endpoint ───────────────────────────────────────────────
# Found at: grafana.com → your stack → Details → OpenTelemetry
# Regions: prod-us-central-0 | prod-eu-west-0 | prod-ap-south-1 | etc.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Auth ──────────────────────────────────────────────────────────────────────
# 1. Go to grafana.com → My Account → Security → Access Policies
# 2. Create policy with scopes: logs:write, metrics:write, traces:write
# 3. Add a token → copy it
# 4. Run: echo -n "<instanceId>:<token>" | base64
# 5. Paste the output below (no surrounding quotes)
# Instance ID is the numeric ID shown in your stack Details page
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceId:apiToken)>

# ── Resource attributes ───────────────────────────────────────────────────────
# Shown as labels on every log/trace/metric in Grafana
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=<dev|staging|prod>,service.namespace=<your-namespace>

# ── Signal exporters ──────────────────────────────────────────────────────────
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none   # set to otlp once metrics:write is confirmed working

# ── Internal telemetry (SQLite + hardware metrics worker) ────────────────────
emit_telemetry=true           # set to false to disable hardware metrics worker

# ── Log level ─────────────────────────────────────────────────────────────────
RUST_LOG=info                 # options: trace | debug | info | warn | error

# ── App secrets (fill these in separately, never commit) ─────────────────────
JWT_SECRET=<your-jwt-secret>
